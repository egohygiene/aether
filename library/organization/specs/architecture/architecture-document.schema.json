{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/aether/architecture-document.v1.schema.json",
  "title": "Aether Architecture Document Frontmatter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "version",
    "status",
    "owners",
    "created",
    "updated",
    "governed_by",
    "depends_on",
    "related",
    "supersedes"
  ],
  "properties": {
    "schema": {
      "const": "aether.architecture-document/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "architecture-document"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "provisional",
        "draft",
        "active",
        "deprecated",
        "superseded",
        "archived"
      ]
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "governed_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^architecture-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "depends_on": {
      "$ref": "#/$defs/artifactIdentifiers"
    },
    "related": {
      "$ref": "#/$defs/artifactIdentifiers"
    },
    "supersedes": {
      "$ref": "#/$defs/artifactIdentifiers"
    }
  },
  "$defs": {
    "artifactIdentifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}

