{
  "$id": "https://egohygiene.io/schemas/aether/social-campaign-handoff/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether review-gated social campaign handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet", "intent", "identity", "catalog", "channels", "review", "publishing_checklist", "external_handoff", "publication", "lifecycle"],
  "properties": {
    "schema_version": {"const": "aether.social-campaign-handoff/v1"},
    "packet": {"$ref": "#/$defs/packet"},
    "intent": {"$ref": "#/$defs/intent"},
    "identity": {"$ref": "#/$defs/identity"},
    "catalog": {"$ref": "#/$defs/catalog"},
    "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel"}},
    "review": {"$ref": "#/$defs/review"},
    "publishing_checklist": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/checklistItem"}},
    "external_handoff": {"$ref": "#/$defs/externalHandoff"},
    "publication": {"$ref": "#/$defs/publication"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"}
  },
  "allOf": [
    {
      "if": {"properties": {"packet": {"properties": {"state": {"const": "draft"}}}}},
      "then": {
        "properties": {
          "review": {"properties": {"status": {"const": "pending"}, "approval": {"type": "null"}}},
          "external_handoff": {"properties": {"authorized": {"const": false}}},
          "publication": {"properties": {"status": {"const": "not-published"}, "receipt": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"packet": {"properties": {"state": {"const": "reviewed"}}}}},
      "then": {
        "properties": {
          "review": {"properties": {"status": {"const": "reviewed"}, "approval": {"type": "null"}}},
          "external_handoff": {"properties": {"authorized": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"packet": {"properties": {"state": {"enum": ["approved-for-export", "published"]}}}}},
      "then": {
        "properties": {
          "review": {"properties": {"status": {"const": "approved-for-export"}, "approval": {"$ref": "#/$defs/approval"}}},
          "external_handoff": {"properties": {"authorized": {"const": true}, "authorization_approval_id": {"type": "string"}}}
        }
      }
    },
    {
      "if": {"properties": {"packet": {"properties": {"state": {"const": "published"}}}}},
      "then": {"properties": {"publication": {"properties": {"status": {"const": "published"}, "receipt": {"$ref": "#/$defs/publicationReceipt"}}}}}
    },
    {
      "if": {"properties": {"packet": {"properties": {"state": {"const": "superseded"}}}}},
      "then": {"properties": {"packet": {"properties": {"superseded_by": {"type": "string"}}}}}
    }
  ],
  "$defs": {
    "digestValue": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha256-utf8-lf", "sha256-canonical-json", "sha256-bytes"]},
        "value": {"$ref": "#/$defs/digestValue"}
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "state", "created_at", "superseded_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^campaign/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "state": {"enum": ["draft", "reviewed", "approved-for-export", "published", "superseded"]},
        "created_at": {"type": "string", "minLength": 1},
        "superseded_by": {"type": ["string", "null"], "pattern": "^campaign/[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "sourcedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "source": {"const": "user-supplied"}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "audience", "context"],
      "properties": {
        "objective": {"$ref": "#/$defs/sourcedText"},
        "audience": {"$ref": "#/$defs/sourcedText"},
        "context": {"$ref": "#/$defs/sourcedText"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_schema", "artifact_version", "project_id", "source_digest", "package_digest"],
      "properties": {
        "artifact_schema": {"const": "identity.social-surface-package/v1"},
        "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "project_id": {"type": "string", "minLength": 1},
        "source_digest": {"$ref": "#/$defs/digestValue"},
        "package_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "liveVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required", "verified_at", "verified_by", "evidence"],
      "properties": {
        "status": {"enum": ["required", "verified"]},
        "required": {"type": "boolean"},
        "verified_at": {"type": ["string", "null"]},
        "verified_by": {"type": ["string", "null"]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "captured_at", "source_urls", "freshness_notice", "live_verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^catalog/[a-z0-9-]+$"},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "captured_at": {"type": "string", "minLength": 1},
        "source_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "freshness_notice": {"type": "string", "minLength": 1},
        "live_verification": {"$ref": "#/$defs/liveVerification"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthPx", "heightPx"],
      "properties": {
        "widthPx": {"type": "integer", "minimum": 1},
        "heightPx": {"type": "integer", "minimum": 1}
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "platform", "placement", "use", "mediaFormat", "dimensions", "safeZone", "verification", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^surface/[a-z0-9-]+$"},
        "platform": {"type": "string", "minLength": 1},
        "placement": {"type": "string", "minLength": 1},
        "use": {"enum": ["organic", "advertising"]},
        "mediaFormat": {"type": ["string", "null"]},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "safeZone": {"type": "object"},
        "verification": {"type": "object"},
        "source": {"type": "object"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "media_type", "alt_text", "license", "origin", "identity_approvals"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digestValue"},
        "media_type": {"type": "string", "minLength": 1},
        "alt_text": {"type": "string", "minLength": 1},
        "license": {"type": "object"},
        "origin": {"type": "object"},
        "identity_approvals": {"type": "object"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status", "evidence", "approval_id"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "approved"]},
        "evidence": {"type": ["string", "null"]},
        "approval_id": {"type": ["string", "null"]}
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "status", "approval_id", "claims"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source": {"enum": ["user-supplied", "identity-approved"]},
        "status": {"enum": ["candidate", "approved"]},
        "approval_id": {"type": ["string", "null"]},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "text"],
      "properties": {
        "required": {"type": "boolean"},
        "text": {"type": ["string", "null"]}
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_id", "surface", "asset", "copy", "required_link", "attribution", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "target_id": {"type": "string", "minLength": 1},
        "surface": {"$ref": "#/$defs/surface"},
        "asset": {"$ref": "#/$defs/asset"},
        "copy": {"$ref": "#/$defs/copy"},
        "required_link": {"type": ["string", "null"]},
        "attribution": {"$ref": "#/$defs/attribution"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_target_path", "catalog_record_id", "catalog_source"],
          "properties": {
            "identity_target_path": {"type": "string", "minLength": 1},
            "catalog_record_id": {"type": "string", "minLength": 1},
            "catalog_source": {"type": "object"}
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "packet_id", "reviewed_packet_digest", "decision", "approved_by", "approved_at", "evidence"],
      "properties": {
        "schema_version": {"const": "aether.social-campaign-approval/v1"},
        "id": {"type": "string", "pattern": "^approval/[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "packet_id": {"type": "string", "minLength": 1},
        "reviewed_packet_digest": {"$ref": "#/$defs/digest"},
        "decision": {"const": "approved-for-export"},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "notes", "approval"],
      "properties": {
        "status": {"enum": ["pending", "reviewed", "approved-for-export"]},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]},
        "approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/approval"}]}
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "status", "evidence", "completed_by", "completed_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "completed", "not-applicable"]},
        "evidence": {"type": ["string", "null"]},
        "completed_by": {"type": ["string", "null"]},
        "completed_at": {"type": ["string", "null"]}
      }
    },
    "externalHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "allowed_action", "authorization_approval_id", "adapter"],
      "properties": {
        "authorized": {"type": "boolean"},
        "allowed_action": {"const": "immutable-export-only"},
        "authorization_approval_id": {"type": ["string", "null"]},
        "adapter": {"type": ["string", "null"]}
      }
    },
    "publicationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "authorization_approval_id", "platform_event_id", "published_at", "exported_packet_digest"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "authorization_approval_id": {"type": "string", "minLength": 1},
        "platform_event_id": {"type": "string", "minLength": 1},
        "published_at": {"type": "string", "minLength": 1},
        "exported_packet_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt"],
      "properties": {
        "status": {"enum": ["not-published", "published"]},
        "receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publicationReceipt"}]}
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "actor", "occurred_at", "reason"],
      "properties": {
        "from": {"type": ["string", "null"]},
        "to": {"enum": ["draft", "reviewed", "approved-for-export", "published", "superseded"]},
        "actor": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history"],
      "properties": {
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/historyEvent"}}
      }
    }
  }
}
