{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/aether/continuity-dispositions/v1.json",
  "title": "Aether continuity disposition inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract",
    "composition_skill",
    "reviewed_at",
    "scope",
    "verified_repository_classes",
    "verified_hosts",
    "skills",
    "agents"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "aether.continuity-dispositions/v1" },
    "contract": { "const": "aether.repository-continuity/v1" },
    "composition_skill": { "const": "maintain-repository-continuity" },
    "reviewed_at": { "type": "string", "format": "date" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_skills", "canonical_agents", "staged_content"],
      "properties": {
        "canonical_skills": { "const": "library/organization/skills/**/SKILL.md" },
        "canonical_agents": { "const": "library/organization/agents/*/AGENT.md" },
        "staged_content": { "const": "evidence-only; never bulk-edit" }
      }
    },
    "verified_repository_classes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_hosts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dispositionRecord" }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dispositionRecord" }
    }
  },
  "$defs": {
    "dispositionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "disposition",
        "startup_read",
        "pre_pr_write",
        "domain_evidence",
        "never_claim",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source": {
          "type": "string",
          "pattern": "^library/organization/(?:skills/.+/SKILL|agents/[^/]+/AGENT)\\.md$"
        },
        "disposition": {
          "enum": ["reader", "writer", "reader-writer", "read-only", "not-applicable"]
        },
        "startup_read": { "type": "boolean" },
        "pre_pr_write": { "type": "boolean" },
        "domain_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "never_claim": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "reader" } } },
          "then": {
            "properties": {
              "startup_read": { "const": true },
              "pre_pr_write": { "const": false },
              "domain_evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "writer" } } },
          "then": {
            "properties": {
              "startup_read": { "const": false },
              "pre_pr_write": { "const": true },
              "domain_evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "reader-writer" } } },
          "then": {
            "properties": {
              "startup_read": { "const": true },
              "pre_pr_write": { "const": true },
              "domain_evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "read-only" } } },
          "then": {
            "properties": {
              "startup_read": { "const": true },
              "pre_pr_write": { "const": false },
              "domain_evidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "disposition": { "const": "not-applicable" } } },
          "then": {
            "properties": {
              "startup_read": { "const": false },
              "pre_pr_write": { "const": false },
              "domain_evidence": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
