{
  "$id": "https://egohygiene.io/schemas/aether/external-source-review-register/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether external source review register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "reviewed_at", "reviewer", "coverage", "sources"],
  "properties": {
    "schema_version": {"const": "aether.external-source-review-register/v1"},
    "catalog_version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"},
    "reviewed_at": {"format": "date-time", "type": "string"},
    "reviewer": {"minLength": 1, "type": "string"},
    "coverage": {
      "additionalProperties": false,
      "required": ["captured_artifact_count", "captured_source_count", "coverage_rule"],
      "properties": {
        "captured_artifact_count": {"minimum": 0, "type": "integer"},
        "captured_source_count": {"minimum": 0, "type": "integer"},
        "coverage_rule": {"minLength": 1, "type": "string"}
      },
      "type": "object"
    },
    "sources": {
      "items": {"$ref": "#/$defs/source_review"},
      "minItems": 1,
      "type": "array"
    }
  },
  "$defs": {
    "assessment": {
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": {
          "enum": ["verified", "active-at-review", "redirected-at-review", "restricted", "deferred", "rejected", "not-applicable", "unknown"],
          "type": "string"
        },
        "evidence": {"minLength": 1, "type": "string"}
      },
      "type": "object"
    },
    "source_review": {
      "additionalProperties": false,
      "required": [
        "id",
        "upstream_repository",
        "source_kind",
        "pinned_revision",
        "captured_artifact_count",
        "decision",
        "decision_reason",
        "assessment",
        "constraints",
        "next_review"
      ],
      "properties": {
        "id": {"pattern": "^external-source/[a-z0-9-]+$", "type": "string"},
        "upstream_repository": {"minLength": 1, "type": "string"},
        "source_kind": {"enum": ["git-repository", "web-snapshot"], "type": "string"},
        "pinned_revision": {
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["git-commit", "content-digest"], "type": "string"},
            "value": {"minLength": 1, "type": "string"}
          },
          "type": "object"
        },
        "captured_artifact_count": {"minimum": 0, "type": "integer"},
        "decision": {"enum": ["allowlisted", "deferred", "rejected"], "type": "string"},
        "decision_reason": {"minLength": 1, "type": "string"},
        "assessment": {
          "additionalProperties": false,
          "required": ["license", "maintenance", "trust", "duplication", "relevance", "vulnerability"],
          "properties": {
            "license": {"$ref": "#/$defs/assessment"},
            "maintenance": {"$ref": "#/$defs/assessment"},
            "trust": {"$ref": "#/$defs/assessment"},
            "duplication": {"$ref": "#/$defs/assessment"},
            "relevance": {"$ref": "#/$defs/assessment"},
            "vulnerability": {"$ref": "#/$defs/assessment"}
          },
          "type": "object"
        },
        "constraints": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "uniqueItems": true,
          "type": "array"
        },
        "next_review": {
          "additionalProperties": false,
          "required": ["not_after", "events"],
          "properties": {
            "not_after": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "type": "string"},
            "events": {
              "items": {"minLength": 1, "type": "string"},
              "minItems": 1,
              "uniqueItems": true,
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}
