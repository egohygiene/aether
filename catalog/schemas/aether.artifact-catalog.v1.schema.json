{
  "$id": "aether.artifact-catalog/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "properties": {
                    "state": {
                      "const": "deprecated"
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "properties": {
                "deprecation": {
                  "properties": {
                    "replacement_id": {
                      "pattern": "^[a-z]+/[a-z0-9-]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "replacement_id"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "artifact_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "type": "string"
          },
          "compatibility": {
            "additionalProperties": false,
            "properties": {
              "notes": {
                "type": "string"
              },
              "required_tools": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "required_tools"
            ],
            "type": "object"
          },
          "dependencies": {
            "items": {
              "pattern": "^[a-z]+/[a-z0-9-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "deprecation": {
            "additionalProperties": false,
            "properties": {
              "notes": {
                "type": "string"
              },
              "replacement_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^[a-z]+/[a-z0-9-]+$",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "replacement_id"
            ],
            "type": "object"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "domain": {
            "minLength": 1,
            "type": "string"
          },
          "generated_distribution_paths": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z]+/[a-z0-9-]+$",
            "type": "string"
          },
          "implements_specification_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^specification/[a-z0-9-]+$",
                "type": "string"
              }
            ]
          },
          "kind": {
            "enum": [
              "specification",
              "skill",
              "agent",
              "instruction",
              "hook",
              "schema",
              "other"
            ],
            "type": "string"
          },
          "license": {
            "minLength": 1,
            "type": "string"
          },
          "lifecycle": {
            "additionalProperties": false,
            "properties": {
              "source_state": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "draft",
                  "experimental",
                  "stable",
                  "deprecated",
                  "retired"
                ],
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          "owner": {
            "additionalProperties": false,
            "properties": {
              "maintainers": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "primary": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "primary",
              "maintainers"
            ],
            "type": "object"
          },
          "related_ids": {
            "items": {
              "pattern": "^[a-z]+/[a-z0-9-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "release": {
            "additionalProperties": false,
            "properties": {
              "included": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "included"
            ],
            "type": "object"
          },
          "scope": {
            "enum": [
              "organization",
              "repository",
              "personal"
            ],
            "type": "string"
          },
          "source_digest": {
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256-utf8-lf",
                "type": "string"
              },
              "value": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "algorithm",
              "value"
            ],
            "type": "object"
          },
          "source_path": {
            "pattern": "^library/organization/(skills|specs)/",
            "type": "string"
          },
          "supersedes_ids": {
            "items": {
              "pattern": "^[a-z]+/[a-z0-9-]+$",
              "type": "string"
            },
            "type": "array"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "description",
          "source_path",
          "artifact_version",
          "lifecycle",
          "owner",
          "scope",
          "license",
          "domain",
          "tags",
          "dependencies",
          "related_ids",
          "implements_specification_id",
          "compatibility",
          "generated_distribution_paths",
          "supersedes_ids",
          "deprecation",
          "source_digest",
          "release"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "canonical_source_of_truth": {
          "type": "string"
        },
        "catalog_role_when_overlap": {
          "type": "string"
        }
      },
      "required": [
        "canonical_source_of_truth",
        "catalog_role_when_overlap"
      ],
      "type": "object"
    },
    "lifecycle_policy": {
      "additionalProperties": false,
      "properties": {
        "allowed_transitions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "breaking_change_policy": {
          "type": "string"
        },
        "deprecated_requires_replacement": {
          "const": true,
          "type": "boolean"
        },
        "releasable_states": {
          "const": [
            "stable"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retired_id_reuse": {
          "const": false,
          "type": "boolean"
        },
        "staged_external_policy": {
          "type": "string"
        },
        "states": {
          "const": [
            "draft",
            "experimental",
            "stable",
            "deprecated",
            "retired"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "states",
        "allowed_transitions",
        "releasable_states",
        "deprecated_requires_replacement",
        "retired_id_reuse",
        "breaking_change_policy",
        "staged_external_policy"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "aether.artifact-catalog/v1",
      "type": "string"
    },
    "serialization": {
      "additionalProperties": false,
      "properties": {
        "canonical_json": {
          "const": "json.dumps(sort_keys=true,separators=(\",\",\":\"))",
          "type": "string"
        },
        "encoding": {
          "const": "UTF-8",
          "type": "string"
        },
        "line_endings": {
          "const": "LF",
          "type": "string"
        },
        "source_digest_algorithm": {
          "const": "sha256-utf8-lf",
          "type": "string"
        }
      },
      "required": [
        "canonical_json",
        "line_endings",
        "encoding",
        "source_digest_algorithm"
      ],
      "type": "object"
    },
    "versioning": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_contract": {
          "type": "string"
        },
        "repository_release_tag_contract": {
          "type": "string"
        }
      },
      "required": [
        "repository_release_tag_contract",
        "artifact_version_contract"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "authority",
    "versioning",
    "serialization",
    "lifecycle_policy",
    "artifacts"
  ],
  "title": "Aether artifact catalog",
  "type": "object"
}
