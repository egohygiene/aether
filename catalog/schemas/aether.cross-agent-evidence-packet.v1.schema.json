{
  "$id": "https://egohygiene.io/schemas/aether/cross-agent-evidence-packet/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether cross-agent public evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet", "payload", "integrity"],
  "properties": {
    "schema_version": {"const": "aether.cross-agent-evidence-packet/v1"},
    "packet": {"$ref": "#/$defs/packetIdentity"},
    "payload": {"$ref": "#/$defs/payload"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "digestValue": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"enum": ["sha256-canonical-json", "sha256-bytes"]},
        "value": {"$ref": "#/$defs/digestValue"}
      }
    },
    "packetIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "producer", "workflow_id", "revision", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^packet/[a-z0-9][a-z0-9._/-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "producer": {"type": "string", "minLength": 1},
        "workflow_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "scope", "public_inputs_only"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "public_inputs_only": {"const": true}
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "url", "media_type", "bytes", "digest", "sensitivity", "content_treatment"],
      "properties": {
        "id": {"type": "string", "pattern": "^attachment/[a-z0-9][a-z0-9._/-]*$"},
        "kind": {"enum": ["relative-file", "immutable-reference"]},
        "path": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "media_type": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"},
        "sensitivity": {"const": "public"},
        "content_treatment": {"const": "untrusted-evidence"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "relative-file"}}}, "then": {"properties": {"path": {"type": "string", "minLength": 1}, "url": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "immutable-reference"}}}, "then": {"properties": {"path": {"type": "null"}, "url": {"type": "string", "pattern": "^https://"}}}}
      ]
    },
    "excerpt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "attachment_id", "start_byte", "end_byte", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^excerpt/[a-z0-9][a-z0-9._/-]*$"},
        "attachment_id": {"type": "string", "minLength": 1},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "stable_source_id", "authority", "jurisdiction_id", "retrieved_at", "effective_at", "rights", "digest", "attachment_ids", "excerpts"],
      "properties": {
        "id": {"type": "string", "pattern": "^source/[a-z0-9][a-z0-9._/-]*$"},
        "url": {"type": ["string", "null"], "pattern": "^https://"},
        "stable_source_id": {"type": ["string", "null"]},
        "authority": {"enum": ["primary", "official", "secondary", "unknown"]},
        "jurisdiction_id": {"type": "string", "minLength": 1},
        "retrieved_at": {"$ref": "#/$defs/timestamp"},
        "effective_at": {"type": ["string", "null"], "format": "date-time"},
        "rights": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "attachment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excerpts": {"type": "array", "items": {"$ref": "#/$defs/excerpt"}}
      },
      "anyOf": [
        {"required": ["url"], "properties": {"url": {"type": "string"}}},
        {"required": ["stable_source_id"], "properties": {"stable_source_id": {"type": "string", "minLength": 1}}}
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["attachments", "sources"],
      "properties": {
        "attachments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attachment"}},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence_refs", "uncertainty", "limitations"],
      "properties": {
        "id": {"type": "string", "pattern": "^finding/[a-z0-9][a-z0-9._/-]*$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["supported", "partial", "unsupported", "unknown"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "uncertainty": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "findings": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "rejected_claims", "overall_limitations"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "rejected_claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "overall_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["transformations", "tools"],
      "properties": {
        "transformations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "operation", "input_refs", "output_refs"], "properties": {"id": {"type": "string"}, "operation": {"type": "string"}, "input_refs": {"type": "array", "items": {"type": "string"}}, "output_refs": {"type": "array", "items": {"type": "string"}}}}},
        "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_scope", "maximum_sensitivity", "required_policy_ids", "required_session_capabilities", "grants_capabilities", "max_attachment_count", "max_attachment_bytes", "contains_private_data"],
      "properties": {
        "destination_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "maximum_sensitivity": {"const": "public"},
        "required_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_session_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "grants_capabilities": {"const": false},
        "max_attachment_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_attachment_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "contains_private_data": {"const": false}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "evidence"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected", "not-applicable"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "evidence": {"type": ["string", "null"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["human", "sanitization", "declassification"],
      "properties": {
        "human": {"$ref": "#/$defs/decision"},
        "sanitization": {"$ref": "#/$defs/decision"},
        "declassification": {"$ref": "#/$defs/decision"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evaluated_at", "valid_until"],
      "properties": {
        "status": {"enum": ["current", "stale", "unknown"]},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "freshness", "expires_at", "superseded_by", "revocation", "incompatibility", "partial_failures"],
      "properties": {
        "state": {"enum": ["draft", "reviewed", "ready", "partial", "failed", "stale", "superseded", "revoked", "incompatible"]},
        "freshness": {"$ref": "#/$defs/freshness"},
        "expires_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "superseded_by": {"type": ["string", "null"]},
        "revocation": {"type": ["object", "null"], "additionalProperties": false, "required": ["revoked_at", "reason"], "properties": {"revoked_at": {"$ref": "#/$defs/timestamp"}, "reason": {"type": "string", "minLength": 1}}},
        "incompatibility": {"type": ["string", "null"]},
        "partial_failures": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["request", "evidence", "findings", "provenance", "policy", "review", "lifecycle"],
      "properties": {
        "request": {"$ref": "#/$defs/request"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "findings": {"$ref": "#/$defs/findings"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "policy": {"$ref": "#/$defs/policy"},
        "review": {"$ref": "#/$defs/review"},
        "lifecycle": {"$ref": "#/$defs/lifecycle"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "algorithm", "key_id", "value"],
      "properties": {
        "status": {"enum": ["verified", "unverified", "unsigned"]},
        "algorithm": {"type": ["string", "null"]},
        "key_id": {"type": ["string", "null"]},
        "value": {"type": ["string", "null"]}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_digest", "signature"],
      "properties": {
        "envelope_digest": {"$ref": "#/$defs/digest"},
        "signature": {"$ref": "#/$defs/signature"}
      }
    }
  }
}
