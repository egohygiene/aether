{
  "$id": "https://egohygiene.io/schemas/aether/evidence-projection/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether evidence transport projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection", "packet_ref", "authority"],
  "properties": {
    "schema_version": {"const": "aether.evidence-projection/v1"},
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "adapter_kind", "adapter_id", "created_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^projection/[a-z0-9][a-z0-9._/-]*$"},
        "adapter_kind": {"enum": ["provider", "mcp", "a2a", "filesystem", "queue"]},
        "adapter_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "packet_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "schema_version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "schema_version": {"const": "aether.cross-agent-evidence-packet/v1"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["destination_scope", "maximum_sensitivity", "required_policy_ids", "required_session_capabilities", "grants_capabilities", "content_transformation"],
      "properties": {
        "destination_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "maximum_sensitivity": {"const": "public"},
        "required_policy_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_session_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "grants_capabilities": {"const": false},
        "content_transformation": {"const": "none"}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json"},
        "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
