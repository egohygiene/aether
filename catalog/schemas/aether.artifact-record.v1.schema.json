{
  "$id": "aether.artifact-record/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "properties": {
              "state": {
                "const": "deprecated"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "deprecation": {
            "properties": {
              "replacement_id": {
                "pattern": "^[a-z]+/[a-z0-9-]+$",
                "type": "string"
              }
            },
            "required": [
              "replacement_id"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "artifact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "required_tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "required_tools"
      ],
      "type": "object"
    },
    "dependencies": {
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "deprecation": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "replacement_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-z]+/[a-z0-9-]+$",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "replacement_id"
      ],
      "type": "object"
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "type": "string"
    },
    "generated_distribution_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z]+/[a-z0-9-]+$",
      "type": "string"
    },
    "implements_specification_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^specification/[a-z0-9-]+$",
          "type": "string"
        }
      ]
    },
    "kind": {
      "enum": [
        "specification",
        "skill",
        "agent",
        "instruction",
        "hook",
        "schema",
        "other"
      ],
      "type": "string"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle": {
      "additionalProperties": false,
      "properties": {
        "source_state": {
          "type": "string"
        },
        "state": {
          "enum": [
            "draft",
            "experimental",
            "stable",
            "deprecated",
            "retired"
          ],
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "owner": {
      "additionalProperties": false,
      "properties": {
        "maintainers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "primary": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "primary",
        "maintainers"
      ],
      "type": "object"
    },
    "related_ids": {
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "release": {
      "additionalProperties": false,
      "properties": {
        "included": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "included"
      ],
      "type": "object"
    },
    "scope": {
      "enum": [
        "organization",
        "repository",
        "personal"
      ],
      "type": "string"
    },
    "source_digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256-utf8-lf",
          "type": "string"
        },
        "value": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "source_path": {
      "pattern": "^library/organization/(skills|specs)/",
      "type": "string"
    },
    "supersedes_ids": {
      "items": {
        "pattern": "^[a-z]+/[a-z0-9-]+$",
        "type": "string"
      },
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "description",
    "source_path",
    "artifact_version",
    "lifecycle",
    "owner",
    "scope",
    "license",
    "domain",
    "tags",
    "dependencies",
    "related_ids",
    "implements_specification_id",
    "compatibility",
    "generated_distribution_paths",
    "supersedes_ids",
    "deprecation",
    "source_digest",
    "release"
  ],
  "title": "Aether first-party artifact record",
  "type": "object"
}
