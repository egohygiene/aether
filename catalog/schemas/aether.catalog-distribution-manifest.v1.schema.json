{
  "$id": "aether.catalog-distribution-manifest/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aether governed catalog distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "catalog_digest", "generated_paths", "generator", "publication"],
  "properties": {
    "schema_version": {"const": "aether.catalog-distribution-manifest/v1"},
    "catalog_id": {"type": "string", "pattern": "^catalog/[a-z0-9-]+$"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "catalog_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256-utf8-lf"},
        "value": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "generated_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "generator": {"type": "string", "minLength": 1},
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["blocked", "eligible"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
