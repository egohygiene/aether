{
  "schema_version": "egohygiene.repository-release/v1",
  "repository": {"id": "egohygiene/react-library", "lifecycle": "active", "release_profile": "npm-package"},
  "release": {"state": "unreleased", "tag_prefix": "v", "immutable_tags": true, "major_alias": "disabled"},
  "changelog": {"path": "CHANGELOG.md", "format": "keep-a-changelog/1.1", "unreleased_heading": "Unreleased"},
  "components": [{"id": "react-library", "kind": "npm-package", "version_authority": {"kind": "package-json", "path": "package.json"}}],
  "delivery": {"channels": [{"kind": "package-registry", "state": "external", "notes": "npm publication uses repository-owned credentials."}]},
  "evidence": {"source": "required", "change": "required", "provenance": "required", "sbom": "required", "signature": "external", "rollback": {"strategy": "revoke-channel", "instructions": "Deprecate or revoke the channel entry, then release a successor."}},
  "automation": {"taskfile_path": "Taskfile.yml", "tasks": {"plan": "release:plan", "prepare": "release:prepare", "verify": "release:verify", "publish": "release:publish"}, "github": {"manual_dispatch_required": true, "workflow_path": ".github/workflows/release.yml", "state": "configured"}}
}
