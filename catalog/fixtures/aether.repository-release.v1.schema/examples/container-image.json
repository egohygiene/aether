{
  "schema_version": "egohygiene.repository-release/v1",
  "repository": {"id": "egohygiene/image-service", "lifecycle": "active", "release_profile": "container-image"},
  "release": {"state": "released", "tag_prefix": "v", "immutable_tags": true, "major_alias": "optional"},
  "changelog": {"path": "CHANGELOG.md", "format": "keep-a-changelog/1.1", "unreleased_heading": "Unreleased"},
  "components": [{"id": "service-image", "kind": "container-image", "version_authority": {"kind": "container-tag", "path": "release/image-release.json", "selector": "images.service.digest"}}],
  "delivery": {"channels": [{"kind": "container-registry", "state": "configured", "notes": "The immutable image digest is required release evidence."}]},
  "evidence": {"source": "required", "change": "required", "provenance": "required", "sbom": "required", "signature": "required", "rollback": {"strategy": "revoke-channel", "instructions": "Revoke the affected channel and publish a corrected immutable image."}},
  "automation": {"taskfile_path": "Taskfile.yml", "tasks": {"plan": "release:plan", "prepare": "release:prepare", "verify": "release:verify", "publish": "release:publish"}, "github": {"manual_dispatch_required": true, "workflow_path": ".github/workflows/release.yml", "state": "configured"}}
}
