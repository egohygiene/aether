{
  "schema_version": "egohygiene.repository-release/v1",
  "repository": {"id": "egohygiene/rust-cli", "lifecycle": "active", "release_profile": "cli-library"},
  "release": {"state": "unreleased", "tag_prefix": "v", "immutable_tags": true, "major_alias": "optional"},
  "changelog": {"path": "CHANGELOG.md", "format": "keep-a-changelog/1.1", "unreleased_heading": "Unreleased"},
  "components": [{"id": "rust-cli", "kind": "crate", "version_authority": {"kind": "cargo-manifest", "path": "Cargo.toml"}}],
  "delivery": {"channels": [{"kind": "github-release", "state": "configured", "relay_profile": "binary"}, {"kind": "package-registry", "state": "external", "notes": "crates.io is a repository-owned adapter."}]},
  "evidence": {"source": "required", "change": "required", "provenance": "required", "sbom": "available", "signature": "unavailable", "rollback": {"strategy": "revert-and-successor-tag", "instructions": "Revert the source change and publish a corrected successor tag."}},
  "automation": {"taskfile_path": "Taskfile.yml", "tasks": {"plan": "release:plan", "prepare": "release:prepare", "verify": "release:verify", "publish": "release:publish"}, "github": {"manual_dispatch_required": true, "workflow_path": ".github/workflows/release.yml", "state": "configured"}}
}
