{
  "schema_version": "egohygiene.repository-release/v1",
  "repository": {"id": "egohygiene/research-paper", "lifecycle": "active", "release_profile": "publication"},
  "release": {"state": "unreleased", "tag_prefix": "v", "immutable_tags": true, "major_alias": "disabled"},
  "changelog": {"path": "CHANGELOG.md", "format": "keep-a-changelog/1.1", "unreleased_heading": "Unreleased"},
  "components": [{"id": "paper-edition", "kind": "publication", "version_authority": {"kind": "publication-metadata", "path": "publication/metadata.json", "selector": "edition"}}],
  "delivery": {"channels": [{"kind": "publication-archive", "state": "external", "notes": "Archive and DOI receipts are supplied by their providers."}]},
  "evidence": {"source": "required", "change": "required", "provenance": "available", "sbom": "not-applicable", "signature": "external", "rollback": {"strategy": "freeze", "instructions": "Freeze the erroneous edition record and publish a corrected successor edition."}},
  "automation": {"taskfile_path": "Taskfile.yml", "tasks": {"plan": "release:plan", "prepare": "release:prepare", "verify": "release:verify", "publish": "release:publish"}, "github": {"manual_dispatch_required": true, "workflow_path": ".github/workflows/release.yml", "state": "configured"}}
}
